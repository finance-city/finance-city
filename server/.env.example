# .env.example - 개발환경 설정
# 복사해서 .env로 사용하세요

# ==========================================
# 한국투자증권 API 인증
# ==========================================
KIS_APPKEY=your_app_key_here
KIS_APPSECRET=your_app_secret_here

# ==========================================
# Redis 설정
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CHANNEL=stock:realtime

# ==========================================
# 스트리밍 서버 설정
# ==========================================
WS_PORT=8081
HEALTH_PORT=8082
MAX_CONNECTIONS=1000

# 배치 처리 주기 (밀리초)
# - 개발환경: 100ms (빠른 반응성)
# - 프로덕션: 50ms (더 빠른 업데이트)  
# - 고부하시: 200ms (서버 부하 감소)
FLUSH_INTERVAL_MS=100

# ==========================================
# 로깅 설정
# ==========================================
LOG_LEVEL=debug
NODE_ENV=development

# ==========================================
# 프로덕션 전용
# ==========================================
# ECR_REGISTRY=123456789012.dkr.ecr.us-west-2.amazonaws.com
# VERSION=1.0.0
